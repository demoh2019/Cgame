config_version=5

[application]

config/name="Cgame SoftBody Hydrostatic Lab"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[physics]

3d/physics_engine="GodotPhysics3D"
# Native per-face buoyancy is opt-in and requires a closed surface.
3d/solver/soft_body_hydrostatic_pressure=true
# Shared flat-world water-plane parameters (rigid and soft bodies).
3d/fluid_plane/enabled=true
3d/fluid_plane/surface_height=2.0
3d/fluid_plane/density=2.5
3d/fluid_plane/drag_coefficient=0.0
# XPBD fabric stretch avoids over-constraining the material at water contact.
3d/solver/soft_body_xpbd_compliance=0.00002
3d/solver/soft_body_xpbd_volume_compliance=0.000002
