config_version=5

[application]

config/name="Cgame Physics Lab"
run/main_scene="res://lab_3d.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")

[display]

window/size/viewport_width=1440
window/size/viewport_height=900

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]

# Select native Cgame GodotPhysics3D explicitly: Jolt has higher default
# priority and does not implement experimental XPBD/FEM soft-body settings.
3d/physics_engine="GodotPhysics3D"

# The built-in GodotPhysics3D soft-body solver can cap cloth/mesh strain.
# These limits affect only the standalone physics lab project.
3d/solver/soft_body_xpbd_strain_max_stretch_ratio=1.5
3d/solver/soft_body_xpbd_strain_min_compression_ratio=0.6
3d/solver/soft_body_xpbd_strain_limit_compliance=0.0
# Enable XPBD edge constraints for direction-dependent cloth behavior.
# Only the Physics Lab demo uses this non-isotropic stretch preset.
# Try ratio=1 to restore uniform edge compliance for comparison.
3d/solver/soft_body_xpbd_compliance=0.00005
# Accumulate irreversible edge weakening only under repeated high strain.
# This is XPBD material fatigue, not mesh fracture/tearing.
3d/solver/soft_body_fatigue_damage_rate=0.8
3d/solver/soft_body_fatigue_yield_strain=0.2
3d/solver/soft_body_fatigue_max_damage=0.85
3d/solver/soft_body_xpbd_parallel_compliance_ratio=0.2
3d/solver/soft_body_xpbd_material_axis=Vector3(1, 0, 0)
# Coupled StVK membrane deformation (GodotPhysics3D backend only).
3d/solver/soft_body_xpbd_membrane_compliance=0.00001
3d/solver/soft_body_membrane_poisson_ratio=0.3
# Opt-in Neo-Hookean FEM for closed convex meshes: cube station has six tets.
3d/solver/soft_body_tetra_fem_compliance=0.00002
3d/solver/soft_body_tetra_fem_poisson_ratio=0.3
# Optional objective bulk FEM damping, separate from StVK surface viscosity.
3d/solver/soft_body_tetra_fem_viscosity=0.8
# Objective internal-viscosity test: damps membrane strain-rate only.
3d/solver/soft_body_membrane_damping_rate=3.0
