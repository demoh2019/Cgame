; Engine configuration file.
config_version=5

[application]

config/name="Albion After"
config/description="A persistent open world: Albion-style tiers, zones and full loot, Days-After-style scavenging and zombies."
run/main_scene="res://scripts/client/online_main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=30

[rendering]

; The default Balanced quality uses 2048/16-bit directional shadows.
; The runtime graphics preset changes atlas size/precision only when needed.
; This avoids first-frame 4096->2048 GPU reallocation on standard settings.
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/16_bits=true

; Cap explicitly opted-in terrain anisotropic samplers at 8x. Performance
; and Balanced keep trilinear sampling, so their GPU texture cost is unchanged.
textures/default_filters/anisotropic_filtering_level=8

; Software occluders are generated only from solid dungeon walls, while the
; viewport disables the extra CPU work in the open world.
occlusion_culling/use_occlusion_culling=true

; SSR is reserved for High/Ultra Forward+; render its rays at half resolution to
; control bandwidth and preserve budget for world geometry and vegetation.
rendering/environment/screen_space_reflection/half_size=true

; SSAO / SSIL add contact depth and diffuse bounce only for Forward+ High/Ultra.
; Half-resolution ray buffers are reconstructed by Godot, avoiding full-res cost.
rendering/environment/ssao/half_size=true
rendering/environment/ssil/half_size=true

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"

[shader_globals]

aa_weather_wetness={
"type": "float",
"value": 0.0
}

aa_puddle_ripple_strength={
"type": "float",
"value": 0.22
}

aa_vegetation_wet_gloss={
"type": "float",
"value": 0.35
}

aa_cloud_shadow_map={
"type": "sampler2D",
"value": "res://assets/textures/cloud_shadow_fallback.tres"
}

aa_cloud_shadow_strength={
"type": "float",
"value": 0.0
}

aa_cloud_shadow_offset={
"type": "vec2",
"value": Vector2(0, 0)
}

aa_terrain_detail_radius={
"type": "float",
"value": 42.0
}

aa_terrain_layer_budget={
"type": "int",
"value": 3
}

aa_leaf_transmission={
"type": "float",
"value": 0.28
}

aa_grass_transmission={
"type": "float",
"value": 0.0
}

aa_grass_normal_wind={
"type": "float",
"value": 0.28
}

aa_vegetation_wind={
"type": "vec3",
"value": Vector3(0, 0, 0)
}

aa_cliff_normal_quality={
"type": "float",
"value": 0.0
}

aa_specular_aa_strength={
"type": "float",
"value": 0.0
}

aa_canopy_occlusion={
"type": "float",
"value": 0.32
}

aa_foliage_fade_width={
"type": "float",
"value": 0.0
}

aa_foliage_tree_cull={
"type": "float",
"value": 160.0
}

aa_foliage_bush_cull={
"type": "float",
"value": 104.0
}

aa_ground_contact_strength={
"type": "float",
"value": 0.28
}
