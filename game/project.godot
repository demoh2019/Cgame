; Engine configuration file.
config_version=5

[application]

config/name="Albion After"
config/description="A persistent open world: Albion-style tiers, zones and full loot, Days-After-style scavenging and zombies."
run/main_scene="res://scripts/client/online_main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=30

[rendering]

; Match the initial Balanced runtime native PBR highlight AA policy, so
; first load does not reconfigure the renderer or blur any UI pixels.
anti_aliasing/screen_space_roughness_limiter/enabled=true
anti_aliasing/screen_space_roughness_limiter/amount=0.25
anti_aliasing/screen_space_roughness_limiter/limit=0.18


; The renderer’s short-range screen-space contact-shadow pass is globally
; compiled in, but individual lights opt in only on Forward+ High/Ultra.
; The custom engine skips the depth prepass when none opt in.
lights_and_shadows/contact_shadow/enabled=true

; The default Balanced quality uses 2048/16-bit directional shadows.
; The runtime graphics preset changes atlas size/precision only when needed.
; This avoids first-frame 4096->2048 GPU reallocation on standard settings.
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/16_bits=true

; Cap explicitly opted-in terrain anisotropic samplers at 8x. Performance
; and Balanced keep trilinear sampling, so their GPU texture cost is unchanged.
textures/default_filters/anisotropic_filtering_level=8

; Software occluders are generated only from solid dungeon walls, while the
; viewport disables the extra CPU work in the open world.
occlusion_culling/use_occlusion_culling=true

; SSR is reserved for High/Ultra Forward+; render its rays at half resolution to
; control bandwidth and preserve budget for world geometry and vegetation.
environment/screen_space_reflection/half_size=true

; SSAO / SSIL add contact depth and diffuse bounce only for Forward+ High/Ultra.
; Half-resolution ray buffers are reconstructed by Godot, avoiding full-res cost.
environment/ssao/half_size=true
environment/ssil/half_size=true

; Optional Ultra SDFGI is heavy on integrated GPUs: compute GI at half resolution.
global_illumination/gi/use_half_resolution=true

; Native sky IBL prefilter reduces high-roughness reflection aliasing.
reflections/sky_reflections/ggx_samples=48
reflections/sky_reflections/ggx_samples.mobile=16

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"

[shader_globals]

aa_weather_wetness={
"type": "float",
"value": 0.0
}

aa_weather_rain={
"type": "float",
"value": 0.0
}

aa_water_caustics_strength={
"type": "float",
"value": 0.0
}

aa_water_caustics_sun={
"type": "float",
"value": 0.0
}

; One sun vector and radiance shared by shallow-water scattering.
; Values are refreshed with the existing cached sky cadence, not every pixel.
aa_sun_to_light={
"type": "vec3",
"value": Vector3(0, 1, 0)
}

aa_sun_radiance={
"type": "vec3",
"value": Vector3(0, 0, 0)
}

aa_puddle_ripple_strength={
"type": "float",
"value": 0.22
}

aa_vegetation_wet_gloss={
"type": "float",
"value": 0.35
}

aa_cloud_shadow_map={
"type": "sampler2D",
"value": "res://assets/textures/cloud_shadow_fallback.tres"
}

aa_cloud_shadow_strength={
"type": "float",
"value": 0.0
}

aa_cloud_shadow_offset={
"type": "vec2",
"value": Vector2(0, 0)
}

aa_terrain_detail_radius={
"type": "float",
"value": 42.0
}

aa_terrain_layer_budget={
"type": "int",
"value": 3
}

aa_terrain_warp_strength={
"type": "float",
"value": 0.0
}

aa_terrain_height_blend={
"type": "float",
"value": 0.0
}

aa_leaf_transmission={
"type": "float",
"value": 0.28
}

; Expensive per-pixel leaf optical tint defaults off until premium quality.
aa_leaf_optics_quality={
"type": "float",
"value": 0.0
}

aa_grass_transmission={
"type": "float",
"value": 0.0
}

aa_grass_normal_wind={
"type": "float",
"value": 0.28
}

aa_vegetation_wind={
"type": "vec3",
"value": Vector3(0, 0, 0)
}

aa_plant_bend={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

aa_plant_shake={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

aa_cliff_normal_quality={
"type": "float",
"value": 0.0
}

aa_specular_aa_strength={
"type": "float",
"value": 0.0
}

aa_canopy_occlusion={
"type": "float",
"value": 0.32
}

aa_foliage_fade_width={
"type": "float",
"value": 0.0
}

aa_foliage_tree_cull={
"type": "float",
"value": 160.0
}

aa_foliage_bush_cull={
"type": "float",
"value": 104.0
}

aa_ground_contact_strength={
"type": "float",
"value": 0.28
}

// The default render quality keeps micro-occlusion off until High/Ultra is selected.
// The terrain shader reuses its existing sampled PBR normals (zero extra taps).
aa_terrain_micro_occlusion={
"type": "float",
"value": 0.0
}

; Variance-mip normal coherence filter is opt-in on High/Ultra.
aa_terrain_normal_variance_strength={
"type": "float",
"value": 0.0
}

aa_terrain_curvature_strength={
"type": "float",
"value": 0.0
}

; CPU-baked terrain sky visibility is a high-tier optional vertex channel.
aa_terrain_horizon_ao_strength={
"type": "float",
"value": 0.0
}
