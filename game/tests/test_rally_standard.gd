extends RefCounted
## Group banner is a crafted, server-owned tactical rally, not a free UI buff.
const Defs = preload("res://scripts/shared/defs.gd")
const Party = preload("res://scripts/shared/party.gd")
const RallyStandard = preload("res://scripts/shared/rally_standard.gd")
const WorldGen = preload("res://scripts/shared/world_gen.gd")
const GameServer = preload("res://scripts/server/game_server.gd")
const Net = preload("res://scripts/shared/net.gd")
const BarricadeTest = preload("res://tests/test_barricades.gd")


func _position(world, point: Vector2) -> Vector3:
	return Vector3(point.x, world.height_at(point.x, point.y), point.y)


func run(t) -> void:
	t.current = "crafted rally standard is bounded and never forged by the client"
	var data: Dictionary = Defs.item(RallyStandard.ITEM_ID)
	var recipe: Dictionary = Defs.recipes().get(RallyStandard.ITEM_ID, {})
	t.eq(data.get("kind", ""), "standard", "rally standard is a real tradeable inventory item")
	t.eq(recipe.get("station", ""), "workbench", "deployable standard must be crafted at a bench")
	t.eq(recipe.get("inputs", {}), {"plank_1": 2, "cloth_1": 2, "scrap": 1},
		"crafted cloth and scavenged scrap fund expedition morale")
	t.eq(recipe.get("output", ""), RallyStandard.ITEM_ID, "recipe outputs precisely one standard")
	t.check(RallyStandard.within_range(Vector3.ZERO, Vector3(RallyStandard.RADIUS, 0, 0)),
		"rally radius includes its boundary")
	t.check(not RallyStandard.within_range(Vector3.ZERO,
		Vector3(RallyStandard.RADIUS + 0.2, 0, 0)), "outside banner cannot benefit")
	t.check(not RallyStandard.within_range(Vector3.ZERO, Vector3(0, 4, 0)),
		"separated floors are excluded")
	t.check(not RallyStandard.within_range(Vector3.INF, Vector3.ZERO),
		"nonfinite coordinates cannot earn regeneration")
	t.near(RallyStandard.bonus_seconds(91.0, 2.0, 0.0, 90.0),
		1.0, 0.001, "expiry in middle of a tick grants only active time")
	t.near(RallyStandard.bonus_seconds(2.0, 3.0, 1.0, 91.0),
		1.0, 0.001, "time before a new banner does not generate recovery")
	t.near(RallyStandard.bonus_seconds(92.0, 2.0, 0.0, 90.0),
		0.0, 0.001, "expired marker cannot award recovery")

	t.current = "world crafting and explicit party invitation are required"
	var world := WorldGen.new(214)
	var server := GameServer.new(world, 214)
	var leader = server.add_player(721, "Quartermaster")
	var mate = server.add_player(722, "Medic")
	var distant = server.add_player(723, "Scout")
	var stranger = server.add_player(724, "Stranger")
	var site: Vector2 = BarricadeTest.new()._find_place(world)
	t.check(site != Vector2.ZERO, "real passable ground exists outside the safe hub")
	if site == Vector2.ZERO:
		return
	var origin: Vector2 = site + Vector2(-2.8, 0)
	leader.position = _position(world, origin)
	mate.position = _position(world, origin + Vector2(0, 1.0))
	distant.position = _position(world, origin + Vector2(0, -1.0))
	stranger.position = _position(world, origin + Vector2(0, 2.0))
	t.check(not world.is_safe(leader.position.x, leader.position.z),
		"banner test takes place outside protected town")
	t.eq(server.cmd_party_standard(721).get("reason", ""), "not_in_party",
		"solo player cannot place group buffs")
	t.check(server.cmd_party_invite(721, 722).get("ok", false),
		"leader invites first group member")
	t.check(server.cmd_party_accept(722).get("ok", false),
		"first member accepts invitation")
	t.check(server.cmd_party_invite(721, 723).get("ok", false),
		"leader invites second group member")
	t.check(server.cmd_party_accept(723).get("ok", false),
		"second member accepts invitation")
	t.eq(server.cmd_party_standard(722).get("reason", ""), "leader_only",
		"ordinary group member cannot place banner for whole party")
	t.eq(server.cmd_party_standard(721).get("reason", ""), "not_carried",
		"unfunded banner cannot be generated by RPC")
	leader.inventory.add("plank_1", 2)
	leader.inventory.add("cloth_1", 2)
	leader.inventory.add("scrap", 1)
	leader.position = _position(world, GameServer.WORKBENCH_POSITION)
	t.eq(server.cmd_party_standard(721).get("reason", ""), "safe_hub",
		"safe town cannot be used to deploy combat banners")
	t.check(server.cmd_craft(721, RallyStandard.ITEM_ID).get("ok", false),
		"server workbench actually crafts a banner from carried material")
	t.eq(leader.inventory.count(RallyStandard.ITEM_ID), 1,
		"crafted banner appears in the real inventory")
	t.eq(leader.inventory.count("scrap"), 0, "one scrap was spent on the standard")
	leader.position = _position(world, origin)
	mate.position = _position(world, origin + Vector2(-16.0, 0))
	distant.position = _position(world, origin + Vector2(-20.0, 0))
	t.eq(server.cmd_party_standard(721).get("reason", ""), "no_companions",
		"no actual companions nearby: no remote squad buff")
	t.eq(leader.inventory.count(RallyStandard.ITEM_ID), 1,
		"failed banner positioning cannot consume materials")

	t.current = "one successful standard gives only nearby party members recovery"
	mate.position = _position(world, origin + Vector2(0, 1.0))
	var placed: Dictionary = server.cmd_party_standard(721)
	t.check(placed.get("ok", false), "leader installs owned banner near an ally")
	if not bool(placed.get("ok", false)):
		return
	t.eq(leader.inventory.count(RallyStandard.ITEM_ID), 0,
		"deploy consumes exactly one crafted banner")
	t.eq(server.cmd_party_standard(721).get("reason", ""), "already_active",
		"repeated client requests cannot place another simultaneous banner")
	t.eq(stranger.id, 724, "nearby stranger is not enrolled in party")
	t.check(server.parties.standard_at(leader.id, leader.position, server.time).size() > 0,
		"leader has a server-authorized active standard")
	t.check(server.parties.standard_at(mate.id, mate.position, server.time).size() > 0,
		"eligible nearby teammate can benefit")
	t.check(server.parties.standard_at(stranger.id, stranger.position, server.time).is_empty(),
		"outsiders cannot receive party recovery even inside its radius")
	t.check(server.parties.standard_at(distant.id, distant.position, server.time).is_empty(),
		"distant accepted members cannot receive remote recovery")
	t.check(server.snapshot_for(721)["you"]["party"]["standard"].size() > 0,
		"owner snapshot contains party standard marker")
	t.check(server.snapshot_for(724)["you"]["party"]["standard"].is_empty(),
		"outsider snapshot reveals no private squad marker")
	for survivor in [leader, mate, distant, stranger]:
		survivor.survival.hunger = 80.0
		survivor.survival.thirst = 80.0
		survivor.survival.stamina = 10.0
		survivor.survival.stamina_recovery_delay = 0.0
		survivor.combat_energy = 10.0
	server.time += 2.0
	server._tick_players(2.0)
	t.near(leader.combat_energy - stranger.combat_energy,
		RallyStandard.ENERGY_PER_SECOND * 2.0, 0.001,
		"nearby leader receives exactly two seconds of energy bonus")
	t.near(mate.combat_energy - stranger.combat_energy,
		RallyStandard.ENERGY_PER_SECOND * 2.0, 0.001,
		"nearby teammate receives exact same tactical recovery")
	t.near(distant.combat_energy, stranger.combat_energy, 0.001,
		"remote member gets no free combat regeneration")
	t.near(leader.survival.stamina - stranger.survival.stamina,
		RallyStandard.STAMINA_PER_SECOND * 2.0, 0.001,
		"banner recovers stamina without raising the natural cap")
	t.near(mate.survival.stamina - stranger.survival.stamina,
		RallyStandard.STAMINA_PER_SECOND * 2.0, 0.001,
		"ally gets the same bounded stamina buff")
	t.near(distant.survival.stamina, stranger.survival.stamina, 0.001,
		"faraway member receives no extra stamina")

	t.current = "starvation, post-sprint delay and fracture suppress bonus"
	leader.survival.hunger = 5.0
	leader.combat_energy = 10.0
	server.time += 1.0
	server._tick_players(1.0)
	t.near(leader.combat_energy, 10.0 + Defs.COMBAT_ENERGY_REGEN, 0.001,
		"starving leader receives no extra energy")
	leader.survival.hunger = 80.0
	leader.survival.stamina = 10.0
	leader.survival.stamina_recovery_delay = 3.0
	server.time += 1.0
	server._tick_players(1.0)
	t.near(leader.survival.stamina, 10.0, 0.001,
		"banner cannot bypass the regular stamina exhaustion delay")
	leader.survival.stamina_recovery_delay = 0.0
	leader.survival.add_fracture(25.0)
	leader.survival.stamina = 10.0
	server.time += 1.0
	server._tick_players(1.0)
	t.near(leader.survival.stamina,
		10.0 + Defs.STAMINA_REGEN_PER_SECOND * leader.survival.stamina_regen_mult,
		0.001, "splint-worthy fractures block extra banner stamina")

	t.current = "expiry, anti-spam, death and disbanding cancel tactical power"
	server.time = RallyStandard.DURATION + 1.0
	t.check(server.parties.standard_at(mate.id, mate.position, server.time).is_empty(),
		"expired standard no longer grants any aura")
	leader.inventory.add(RallyStandard.ITEM_ID, 1)
	t.eq(server.cmd_party_standard(721).get("reason", ""), "cooldown",
		"leader must wait to raise another standard")
	t.eq(leader.inventory.count(RallyStandard.ITEM_ID), 1,
		"refused redeployment keeps remaining crafted item")
	server.time = RallyStandard.COOLDOWN + 1.0
	t.check(server.cmd_party_standard(721).get("ok", false),
		"leader can deploy a second standard after proper cooldown")
	t.eq(leader.inventory.count(RallyStandard.ITEM_ID), 0,
		"second valid placement consumes a second real item")
	leader.survival.hurt(1000.0)
	server._on_player_death(leader, -1)
	t.check(server.parties.standard_at(mate.id, mate.position, server.time).is_empty(),
		"leader death cancels the shared aura immediately")
	t.check(server.snapshot_for(mate.id)["you"]["party"]["standard"].is_empty(),
		"dead leader's marker is removed from all member snapshots")

	t.current = "private leader feedback never leaks to strangers"
	var net := Net.new()
	net.role = "server"
	net.sim = server
	t.check(net._event_visible_to({"type": "party_standard", "peer": 721}, 721),
		"leader receives its own event")
	t.check(not net._event_visible_to({"type": "party_standard", "peer": 721}, 724),
		"unrelated clients never see another player's event")
	net.free()
