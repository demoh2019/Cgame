extends RefCounted
## Server-only scavenging risk/reward rules for real, one-use ruin crates.
## No client-controlled loot, XP, bonus count or zone values.

const Defs = preload("res://scripts/shared/defs.gd")
const XP_BY_ZONE := [15, 20, 30, 45]
const XP_PER_LEVEL := 75
const MAX_LEVEL := 5
const LOCKPICK_ITEM := "lockpick_kit"


## Only the authoritative crate's zone and server inventory permit unlocking.
static func can_unlock(zone: int, owned_kits: int) -> bool:
	return zone >= 2 and zone < XP_BY_ZONE.size() and owned_kits > 0


## Contents are bounded and come exclusively from the server RNG. Valuable
## weapons and rare raid trophies cannot be generated by lockpicks.
static func sealed_compartment_loot(zone: int, rng: RandomNumberGenerator) -> Dictionary:
	if zone < 2 or zone >= XP_BY_ZONE.size():
		return {}
	var tier: int = zone + 1
	var loot: Dictionary = {"scrap": rng.randi_range(2, 4),
		"bar_%d" % tier: rng.randi_range(1, 2)}
	if zone == 3 and rng.randf() < 0.25:
		loot["field_antiseptic"] = 1
	return loot


static func xp_for_zone(zone: int) -> int:
	if zone < 0 or zone >= XP_BY_ZONE.size():
		return 0
	return int(XP_BY_ZONE[zone])


static func level_for_xp(xp: int) -> int:
	return mini(MAX_LEVEL, 1 + maxi(0, xp) / XP_PER_LEVEL)


## Extra mundane salvage; valuable weapons/medicine remain ordinary RNG loot.
## Only red/black crates at level >= 2 get an additional, bounded scrap yield.
static func enriched_loot(zone: int, level: int, base: Dictionary) -> Dictionary:
	var loot: Dictionary = base.duplicate(true)
	if zone < 2 or zone >= XP_BY_ZONE.size() or level < 2:
		return loot
	var bonus: int = mini(MAX_LEVEL - 1, level - 1)
	loot["scrap"] = int(loot.get("scrap", 0)) + bonus
	return loot
