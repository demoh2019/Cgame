# Copy to .env next to docker-compose.yml and change EVERY value before running a public server.
NAKAMA_DB_PASSWORD=change-me-long-random
# Must match the server key the game client uses to talk to Nakama.
NAKAMA_SERVER_KEY=albion_after_key
NAKAMA_HTTP_KEY=change-me-long-random
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=change-me-long-random
