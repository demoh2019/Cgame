extends SceneTree
## Headless integration smoke for Aurora Forest physics.
## Use the compiled Cgame fork containing AdaptiveResolution3D + WorldPartition3D:
## cgame --headless --path misc/cgame_forest_showcase --script res://tests/smoke_physics.gd

const MAX_PHYSICS_FRAMES: int = 180


func _initialize() -> void:
    call_deferred("_run")


func _fail(reason: String) -> void:
    push_error("Forest physics smoke FAILED: " + reason)
    quit(1)


func _run() -> void:
    var packed: PackedScene = load("res://world.tscn")
    if packed == null:
        _fail("main world scene did not load")
        return
    var world := packed.instantiate() as Node3D
    if world == null:
        _fail("world root is not Node3D")
        return
    root.add_child(world)

    var terrain_body := world.get_node_or_null("TerrainCollision") as StaticBody3D
    var player := world.get_node_or_null("ExplorerBody") as CharacterBody3D
    var boundaries := world.get_node_or_null("WorldBoundsCollision") as StaticBody3D
    if terrain_body == null or player == null or boundaries == null:
        _fail("missing terrain, explorer body or perimeter colliders")
        return
    var capsule := player.get_node_or_null("CapsuleCollision") as CollisionShape3D
    if capsule == null or not (capsule.shape is CapsuleShape3D):
        _fail("explorer is missing capsule physics shape")
        return
    var collider := terrain_body.get_node_or_null("CollisionShape3D") as CollisionShape3D
    # Runtime-created terrain collision may have an autogenerated node name.
    if collider == null:
        if terrain_body.get_child_count() < 1 or not (terrain_body.get_child(0) is CollisionShape3D):
            _fail("terrain is missing its collision shape")
            return
        collider = terrain_body.get_child(0)
    if collider.shape == null:
        _fail("terrain collision shape is empty")
        return

    # An actual physics-space query is stronger than a scene-tree-only assertion.
    for i in range(4):
        await physics_frame
    var from := Vector3(0.0, 15.0, 9.0)
    var to := Vector3(0.0, -15.0, 9.0)
    var ray := PhysicsRayQueryParameters3D.create(from, to)
    ray.collision_mask = 1
    var hit: Dictionary = world.get_world_3d().direct_space_state.intersect_ray(ray)
    if hit.is_empty():
        _fail("ray missed the terrain's generated collision mesh")
        return
    if hit.get("collider") != terrain_body:
        _fail("ray hit a different collider instead of terrain")
        return

    # Spawn above the floor and verify gravity + sweep collision keeps the feet on ground.
    player.call("teleport_to_ground", 0.0, 9.0, world.call("height_at", 0.0, 9.0) + 3.0)
    player.velocity = Vector3.ZERO
    var landed: bool = false
    for i in range(MAX_PHYSICS_FRAMES):
        await physics_frame
        if player.is_on_floor():
            landed = true
            break
    if not landed:
        _fail("capsule did not land after free fall")
        return

    var expected_floor: float = float(world.call("height_at", 0.0, 9.0))
    var feet: float = player.global_position.y - 0.95
    if absf(feet - expected_floor) > 0.35:
        _fail("player did not stand at terrain height (feet=%s expected=%s)" % [feet, expected_floor])
        return

    # Streamed cells own collision for visible trunks/rocks as well as render meshes.
    var stream := world.get_node_or_null("WorldPartition_32m") as WorldPartition3D
    if stream == null:
        _fail("native world partition node was not created")
        return
    var has_foliage_collision: bool = false
    for i in range(MAX_PHYSICS_FRAMES):
        for loaded_cell in stream.get_children():
            var obstacles := loaded_cell.get_node_or_null("FoliageCollisions") as StaticBody3D
            if obstacles != null and obstacles.get_child_count() >= 9:
                has_foliage_collision = true
                break
        if has_foliage_collision:
            break
        await physics_frame
    if not has_foliage_collision:
        _fail("streamed tree/rock obstacle shapes did not appear")
        return

    print("Forest physics smoke PASSED: generated terrain trimesh, gravity/capsule floor landing and streamed obstacles")
    quit(0)
