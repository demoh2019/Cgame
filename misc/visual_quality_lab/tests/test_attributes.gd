extends SceneTree

const Attributes = preload("res://addons/visual_quality/attribute_component.gd")


func _initialize() -> void:
	var stats = Attributes.new()
	assert(is_equal_approx(stats.get_stat("move_speed"), 1.0))
	assert(is_equal_approx(stats.get_stat("max_health"), 100.0))
	assert(not stats.set_equipment("", {"move_speed": 0.2}))
	assert(not stats.set_equipment("feet", {"invalid_stat": 1.0}))
	assert(not stats.set_equipment("feet", {"move_speed": INF}))
	assert(stats.set_equipment("feet", {"move_speed": 0.25}))
	assert(is_equal_approx(stats.get_stat("move_speed"), 1.25))
	assert(stats.set_equipment("utility", {"max_stamina": 20.0}))
	assert(is_equal_approx(stats.get_stat("max_stamina"), 120.0))
	assert(stats.apply_timed_effect("dash", {"move_speed": 0.85}, 0.65))
	assert(is_equal_approx(stats.get_stat("move_speed"), 2.10))
	stats._physics_process(0.7)
	assert(stats.effect_remaining("dash") == 0.0)
	assert(is_equal_approx(stats.get_stat("move_speed"), 1.25))
	assert(not stats.apply_timed_effect("infinite", {"move_speed": 1.0}, INF))
	assert(not stats.try_spend_stamina(200.0))
	assert(stats.try_spend_stamina(40.0))
	assert(is_equal_approx(stats.stamina, 60.0))
	stats._physics_process(0.3)
	assert(is_equal_approx(stats.stamina, 60.0), "Regen must respect stamina cooldown")
	stats._physics_process(1.0)
	assert(stats.stamina > 60.0)
	assert(stats.apply_damage(30.0))
	assert(is_equal_approx(stats.health, 70.0))
	assert(stats.heal(500.0))
	assert(is_equal_approx(stats.health, 100.0))
	stats.restore_vitals({"health": -99, "stamina": 999})
	assert(stats.health == 0.0 and stats.stamina == 120.0)
	stats.remove_equipment("feet")
	assert(is_equal_approx(stats.get_stat("move_speed"), 1.0))
	stats.free()
	print("WorldAttributes3D: finite values, modifiers, effects and stamina validated")
	quit(0)
