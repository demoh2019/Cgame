; Open this directory as a standalone Godot project to enable the editor addon.
config_version=5

[application]
config/name="Open World Toolkit"
run/main_scene="res://demo/world_demo.tscn"

[editor_plugins]
enabled=PackedStringArray("res://addons/open_world_toolkit/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"