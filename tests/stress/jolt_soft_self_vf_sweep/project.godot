config_version=5

[application]

config/name="Cgame Jolt Moving-Triangle Self VF CCD"

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=0.0
jolt_physics_3d/simulation/soft_body_self_contacts=true
jolt_physics_3d/simulation/soft_body_self_speculative_vertex_face_ccd=true
jolt_physics_3d/simulation/soft_body_self_edge_contacts=false
jolt_physics_3d/simulation/soft_body_soft_contacts=false
jolt_physics_3d/simulation/soft_body_self_position_projection=false
jolt_physics_3d/simulation/soft_body_self_contact_max_checks=32768
jolt_physics_3d/simulation/soft_body_soft_contact_radius=0.12
jolt_physics_3d/simulation/soft_body_soft_contact_recovery=0.0
jolt_physics_3d/simulation/soft_body_soft_contact_friction=0.0
jolt_physics_3d/simulation/soft_body_soft_ccd_max_sweep=1.0
jolt_physics_3d/simulation/soft_body_soft_ccd_max_correction_speed=128.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
