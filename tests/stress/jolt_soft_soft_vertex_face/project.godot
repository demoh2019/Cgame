config_version=5

[application]

config/name="Cgame Jolt Soft-Soft Vertex Face Contacts"

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=0.0
jolt_physics_3d/simulation/soft_body_soft_contacts=true
jolt_physics_3d/simulation/soft_body_soft_vertex_face_contacts=true
jolt_physics_3d/simulation/soft_body_soft_contact_radius=0.15
jolt_physics_3d/simulation/soft_body_soft_contact_recovery=0.4
jolt_physics_3d/simulation/soft_body_soft_contact_friction=0.25
jolt_physics_3d/simulation/soft_body_soft_contact_max_particle_pairs=16384

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
