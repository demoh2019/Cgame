#!/usr/bin/env python
from misc.utility.scons_hints import *

import glob
import os

import test_builders

Import("env")

# Sources with tests must be explicitly linked first.
# Only files that register tests with TEST_FORCE_LINK take part in the test binary. Standalone
# microbenchmarks and smoke-compile checks (with their own main() or stub headers) are built by hand.
def _has_force_link(p_path):
    with open(p_path, encoding="utf-8", errors="ignore") as f:
        return "TEST_FORCE_LINK" in f.read()


force_link_sources = [f for f in glob.glob("*/**/*.cpp", recursive=True) if _has_force_link(f)]
force_link_header = env.CommandNoCache(
    "force_link.gen.h", env.Value(force_link_sources), env.Run(test_builders.force_link_builder)
)
env.Depends(force_link_header, "test_builders.py")

# Some tests exercise module internals that include bundled third-party headers.
env_tests = env.Clone()
if env["module_ogg_enabled"] and env["builtin_libogg"]:
    env_tests.Prepend(CPPPATH=["#thirdparty/libogg"])

tests_obj = []
if env["scu_build"]:
    # HACK: SCU setup doesn't support recursive/dynamic setup, so we must manually pass the files.
    env_tests.add_source_files(tests_obj, glob.glob(".scu/*.cpp"))
else:
    env_tests.add_source_files(tests_obj, glob.glob("*.cpp") + force_link_sources)

lib = env.add_library("tests", tests_obj)
env.Prepend(LIBS=[lib])
