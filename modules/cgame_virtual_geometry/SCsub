#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_cgame_virtual_geometry = env_modules.Clone()

# meshoptimizer headers live in thirdparty/ (also reachable as "thirdparty/meshoptimizer/meshoptimizer.h" from "#").
env_cgame_virtual_geometry.Prepend(CPPPATH=["#thirdparty/meshoptimizer"])

# The meshoptimizer module compiles the library. When it is disabled, compile the needed
# sources here so this module still links.
if not env.get("module_meshoptimizer_enabled", False):
    thirdparty_obj = []
    thirdparty_dir = "#thirdparty/meshoptimizer/"
    thirdparty_sources = [
        "allocator.cpp",
        "clusterizer.cpp",
        "indexgenerator.cpp",
        "partition.cpp",
        "quantization.cpp",
        "simplifier.cpp",
        "spatialorder.cpp",
    ]
    thirdparty_sources = [thirdparty_dir + file for file in thirdparty_sources]
    env_thirdparty = env_cgame_virtual_geometry.Clone()
    env_thirdparty.disable_warnings()
    env_thirdparty.add_source_files(thirdparty_obj, thirdparty_sources)
    env.modules_sources += thirdparty_obj

env_cgame_virtual_geometry.add_source_files(env.modules_sources, "*.cpp")
